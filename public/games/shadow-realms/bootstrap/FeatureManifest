/**
 * Shadow Realms — SINGLE feature catalog, outside index.html.
 *
 * LATER, new features are added HERE, not to index.html:
 *   defineGameFeature({
 *     id: 'fog-of-war',
 *     dependsOn: ['runtime-clock'],
 *     load: () => import('../world/FogOfWar.js'),
 *   });
 *
 * The imported module exports createFeature(scope, dependencies), returning:
 *   { update(dt) {}, render(ctx, camera) {}, onPointer(event) {}, dispose() {} }
 * Imports only run when the bootstrap starts; disabled features never load.
 * No resource inventories, duplicate GameEngine, fetch, Supabase or backend.
 */
const catalog = [];
const ids = new Set();

export function defineGameFeature(definition) {
  if (!definition || typeof definition.id !== 'string' || !definition.id.trim()) {
    throw new TypeError('Feature requires an ID');
  }
  if (ids.has(definition.id)) throw new Error('Duplicate feature in manifest: ' + definition.id);
  if (typeof definition.create !== 'function' && typeof definition.load !== 'function') {
    throw new TypeError('Feature must supply create() or load()');
  }
  ids.add(definition.id);
  catalog.push(Object.freeze({ ...definition, dependsOn: Object.freeze([...(definition.dependsOn || [])]) }));
  return definition.id;
}

/** A real, tiny built-in feature demonstrating the shared registry without UI changes. */
defineGameFeature({
  id: 'runtime-clock',
  create(scope) {
    const state = { ticks: 0, elapsedSeconds: 0, wholeSeconds: 0 };
    scope.provide('runtimeClock', state);
    return {
      update(dt) {
        state.ticks++;
        state.elapsedSeconds += dt;
        const second = Math.floor(state.elapsedSeconds);
        if (second > state.wholeSeconds) {
          state.wholeSeconds = second;
          scope.emit('game:second', { seconds: second });
        }
      },
      dispose() { /* Scope releases its service automatically. */ },
    };
  },
});

export function getFeatureManifest() { return [...catalog]; }
export default getFeatureManifest;
