export const NEW_STUDIO_FILTERS = Object.freeze({
  types: [],
  visibility: [],
  views: { comparison: 'more', count: '' },
  sort: 'latest',
})

export function studioFilterCopy(value = NEW_STUDIO_FILTERS) {
  const count = value.views?.count
  return {
    types: Array.isArray(value.types) ? [...value.types] : [],
    visibility: Array.isArray(value.visibility) ? [...value.visibility] : [],
    views: {
      comparison: value.views?.comparison === 'less' ? 'less' : 'more',
      count: count == null ? '' : String(count),
    },
    sort: ['latest', 'oldest', 'popular'].includes(value.sort) ? value.sort : 'latest',
  }
}

export function studioFormatCount(value) {
  if (value === null || value === undefined || value === '') return null
  const n = Number(value)
  if (!Number.isFinite(n) || n < 0) return null
  if (n >= 1000) return new Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(n)
  return new Intl.NumberFormat('en', { maximumFractionDigits: 0 }).format(n)
}

export function studioFormatDuration(value) {
  const seconds = Number(value)
  if (!Number.isSafeInteger(seconds) || seconds <= 0) return null
  const h = Math.floor(seconds / 3600)
  const m = Math.floor((seconds % 3600) / 60)
  const s = seconds % 60
  return h > 0 ? `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}` : `${m}:${String(s).padStart(2, '0')}`
}

export function studioVideoThumbnail(video) {
  if (typeof video?.thumbnail_url === 'string' && /^https:\/\//i.test(video.thumbnail_url)) return video.thumbnail_url
  const id = getReelYouTubeId(video?.video_url)
  return id ? `https://img.youtube.com/vi/${id}/hqdefault.jpg` : null
}

export function studioVideoKind(video) {
  if (video?.video_type === 'short') return 'short'
  if (video?.video_type === 'long') return 'long'
  try {
    if (new URL(String(video?.video_url || '')).pathname.toLowerCase().startsWith('/shorts/')) return 'short'
  } catch { /* invalid or absent link */ }
  return 'long'
}

export function studioDateLabel(value) {
  const millis = value ? Date.parse(value) : NaN
  if (!Number.isFinite(millis)) return null
  return new Date(millis).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
}

function timestamp(item) {
  const value = item?.published_at || item?.created_at || item?.updated_at
  const time = value ? Date.parse(value) : NaN
  return Number.isFinite(time) ? time : -Infinity
}

function visibilityOf(item, kind) {
  if (kind === 'playlists') return item?.is_public === true ? 'published' : item?.is_public === false ? 'private' : null
  return item?.status === 'published' ? 'published' : item?.status === 'draft' ? 'draft' : null
}

export function studioFilterItems(items, filters, section) {
  const selected = studioFilterCopy(filters)
  const source = Array.isArray(items) ? items : []
  const number = selected.views.count.trim() === '' ? null : Number(selected.views.count)
  const validThreshold = number !== null && Number.isSafeInteger(number) && number >= 0
  return source.filter(item => {
    const type = section === 'playlists' ? 'playlists' : studioVideoKind(item) === 'short' ? 'shorts' : 'videos'
    if (selected.types.length && !selected.types.includes(type)) return false
    if (selected.visibility.length && !selected.visibility.includes(visibilityOf(item, section))) return false
    if (validThreshold && section !== 'playlists') {
      const count = Number(item.view_count)
      if (item.view_count == null || !Number.isFinite(count)) return false
      if (selected.views.comparison === 'more' && !(count > number)) return false
      if (selected.views.comparison === 'less' && !(count < number)) return false
    }
    return true
  }).sort((a, b) => {
    if (selected.sort === 'popular' && section !== 'playlists') {
      const aViews = Number.isFinite(Number(a.view_count)) && a.view_count != null ? Number(a.view_count) : -1
      const bViews = Number.isFinite(Number(b.view_count)) && b.view_count != null ? Number(b.view_count) : -1
      return bViews - aViews || timestamp(b) - timestamp(a)
    }
    return selected.sort === 'oldest' ? timestamp(a) - timestamp(b) : timestamp(b) - timestamp(a)
  })
}

export function studioFiltersActive(filters) {
  return Boolean(filters?.types?.length || filters?.visibility?.length ||
    (filters?.views?.count != null && String(filters.views.count).trim()) ||
    (filters?.sort && filters.sort !== 'latest'))
}
